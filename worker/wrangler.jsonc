{
  "name": "munchkin-salas",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITS", "class_name": "Limiter" }
    ]
  },
  // SQLite: es el unico almacenamiento de Durable Objects que entra en el plan
  // gratuito de Workers.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ]
}
